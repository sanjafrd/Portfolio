---
import { Icon } from 'astro-icon/components';
import { SOCIAL_LINKS } from '../../lib/navigation';

const year = new Date().getFullYear();
---

<footer
  class="px-6 py-20 md:py-24"
  style="background: radial-gradient(ellipse 120% 100% at 50% 30%, #38160b 0%, #2b1108 100%);"
>
  <div class="mx-auto max-w-5xl text-center">
    <p
      class="footer-fade mb-6 font-medium text-[#bd988d] text-xs uppercase tracking-[0.3em] md:text-sm"
      style="--delay: 0ms"
    >
      Sanjali Frédélisy — Communication
    </p>

    <h2
      class="footer-fade mb-10 font-serif text-4xl text-[#f0e7d7] leading-tight sm:text-5xl md:text-6xl"
      style="--delay: 150ms"
    >
      Créons quelque chose ensemble.
    </h2>

    <div class="footer-fade mb-12 flex justify-center gap-4" style="--delay: 300ms">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link flex h-12 w-12 items-center justify-center rounded-full bg-[#f0e7d7]/10 text-[#f0e7d7] transition-all hover:bg-[#f0e7d7]/20"
            aria-label={link.label}
          >
            <Icon name={link.icon} class="h-5 w-5" />
          </a>
        ))
      }
    </div>

    <div class="footer-fade text-[#f0e7d7]/50 text-sm" style="--delay: 450ms">
      © {year} Sanjali Frédélisy. Tous droits réservés.
    </div>
  </div>
</footer>

<style>
  @keyframes footerFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .footer-fade {
    opacity: 0;
    animation: footerFadeIn 0.6s ease-out var(--delay, 0ms) forwards;
  }

  .social-link {
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }
  .social-link:hover {
    transform: translateY(-5px) scale(1.15);
  }
  .social-link:active {
    transform: scale(0.95);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-fade {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .social-link {
      transition: none;
    }
  }
</style>
