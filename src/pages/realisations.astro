---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import ProjectCard from '../components/astro/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = await getCollection('projects');
const sorted = projects.sort((a, b) => a.data.order - b.data.order);

type ProjectData = CollectionEntry<'projects'>['data'];

// Vignettes qui gardent la photo de présentation puis enchaînent avec les
// visuels du projet (affiches, brochures, kakémonos…). Chaque projet indique
// les images à ajouter. Les pages de détail des projets ne changent pas.
const CARD_EXTRA_IMAGES: Record<string, (data: ProjectData) => ImageMetadata[]> = {
  hygiene: (d) => (d.galleryImages ?? []).slice(0, 1),
  'taxe-apprentissage': (d) => d.galleryImages ?? [],
  vaccination: (d) => d.galleryImages ?? [],
  oralite: (d) => d.galleryImages ?? [],
  cem: (d) => d.galleryImages ?? [],
  kakemono: (d) => [...(d.detailImagesTop ?? []), ...(d.detailImagesBottom ?? [])],
};

function cardCarousel(project: CollectionEntry<'projects'>) {
  const build = CARD_EXTRA_IMAGES[project.id];
  if (build) {
    const extra = build(project.data);
    if (extra.length > 0) return [project.data.cover, ...extra];
  }
  return project.data.carouselImages;
}
---

<BaseLayout
  title="Réalisations — Sanjali Frédélisy"
  description="Découvrez mes projets de communication visuelle, création graphique et stratégie — école du numérique et alternance en association."
>
  <section
    class="min-h-screen bg-gradient-to-br from-[#f0e7d7] via-[#f9e0da]/30 to-[#f0e7d7] px-4 py-24 sm:px-6 sm:py-32"
  >
    <div class="mx-auto max-w-5xl">
      <header class="mb-8 text-center sm:mb-10">
        <h1
          id="realisations-title"
          class="mb-6 font-medium font-serif text-5xl text-[#5c2c1f] sm:text-6xl md:text-7xl"
        >
          Réalisations
        </h1>
      </header>

      <nav
        class="mb-16 flex flex-wrap justify-center gap-3 sm:mb-24"
        aria-label="Filtrer les réalisations par catégorie"
      >
        <a
          href="/realisations?filter=entreprise"
          data-filter-tab="entreprise"
          class="filter-tab"
        >
          Association Saint-François d'Assise
        </a>
        <a
          href="/realisations?filter=ecole"
          data-filter-tab="ecole"
          class="filter-tab"
        >
          École du numérique
        </a>
      </nav>

      <div id="project-list" class="flex flex-col gap-8">
        {
          sorted.map((project, index) => (
            <div
              class="project-card-wrapper"
              data-type={project.data.type}
              data-order={project.data.order}
            >
              <ProjectCard
                href={`/projet/${project.id}`}
                title={project.data.title}
                category={project.data.category}
                description={project.data.description}
                cover={project.data.cover}
                carouselImages={cardCarousel(project)}
                index={index}
                slug={project.id}
              />
            </div>
          ))
        }
      </div>

      <div id="empty-state" class="hidden py-32 text-center">
        <p class="font-serif text-2xl text-[#bd988d]">
          Aucun projet à afficher pour le moment.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const FILTER_TITLES: Record<string, string> = {
    ecole: 'École du numérique',
    entreprise: "Association Saint-François d'Assise",
  };

  function applyFilter() {
    const params = new URLSearchParams(window.location.search);
    const filter = params.get('filter');

    const title = document.getElementById('realisations-title');
    if (title) {
      title.textContent =
        filter && FILTER_TITLES[filter] ? FILTER_TITLES[filter] : 'Réalisations';
    }

    const tabs = document.querySelectorAll<HTMLElement>('[data-filter-tab]');
    tabs.forEach((tab) => {
      const isActive = tab.dataset.filterTab === filter;
      tab.classList.toggle('is-active', isActive);
      if (isActive) {
        tab.setAttribute('aria-current', 'page');
      } else {
        tab.removeAttribute('aria-current');
      }
    });

    const cards = document.querySelectorAll<HTMLElement>('.project-card-wrapper');
    let visible = 0;
    cards.forEach((card) => {
      const type = card.dataset.type;
      const show = !filter || filter === 'all' || type === filter;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    const empty = document.getElementById('empty-state');
    const list = document.getElementById('project-list');
    if (empty && list) {
      empty.classList.toggle('hidden', visible > 0);
      list.classList.toggle('hidden', visible === 0);
    }
  }

  document.addEventListener('astro:page-load', applyFilter);
</script>

<style>
  .filter-tab {
    display: inline-block;
    border-radius: 9999px;
    border: 1px solid rgba(112, 42, 12, 0.3);
    padding: 0.625rem 1.5rem;
    font-weight: 500;
    font-size: 0.875rem;
    color: #702a0c;
    text-align: center;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .filter-tab:hover {
    background-color: rgba(112, 42, 12, 0.08);
  }
  .filter-tab.is-active {
    background-color: #702a0c;
    border-color: #702a0c;
    color: #f0e7d7;
  }
</style>
