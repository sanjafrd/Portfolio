---
import { Image } from 'astro:assets';
import sanjaliPhoto from '../assets/profile/sanjali.png';
import BaseLayout from '../layouts/BaseLayout.astro';

const parcours = [
  { label: 'Bac général', detail: '2021' },
  { label: 'Licence 1 Psychologie', detail: '2022' },
  { label: 'Restauration & événementiel', detail: 'Juin 2022 – Juillet 2024' },
  {
    label: 'BTS Communication en alternance',
    detail: 'Septembre 2024 – Juin 2026',
  },
  {
    label: 'Bachelor en communication',
    detail: 'Admission',
    upcoming: true,
  },
];

const dotClass = (upcoming?: boolean) =>
  `h-5 w-5 shrink-0 rounded-full ring-4 ring-[#f0e7d7] ${
    upcoming
      ? 'border-2 border-[#702a0c] bg-[#f0e7d7] animate-pulse'
      : 'bg-[#702a0c]'
  }`;

const qualities = [
  {
    title: 'Créative',
    description:
      "J'aime imaginer des concepts, créer des univers visuels, concevoir des supports de communication et trouver des idées originales pour valoriser un projet ou un événement.",
  },
  {
    title: 'Organisée',
    description:
      "Je gère plusieurs projets en même temps, je coordonne des événements, je travaille avec différents interlocuteurs et je respecte les délais, ce qui demande une bonne organisation.",
  },
  {
    title: 'Polyvalente',
    description:
      "Je touche à de nombreux domaines de la communication : événementiel, réseaux sociaux, graphisme, rédaction, communication interne, print, digital et gestion de projet.",
  },
];

const passions = [
  {
    title: 'Sport',
    description:
      "Le sport fait partie de mon quotidien. Il m'aide à me dépasser, à rester disciplinée et à maintenir un bon équilibre de vie.",
  },
  {
    title: 'Bien-être',
    description:
      "J'accorde une grande importance à l'équilibre entre le corps et l'esprit, à travers des habitudes qui favorisent le bien-être au quotidien.",
  },
  {
    title: 'Lecture',
    description:
      "J'aime lire pour découvrir de nouvelles histoires, apprendre et m'évader.",
  },
  {
    title: 'Piano',
    description:
      "Le piano me permet d'exprimer ma créativité, de me détendre et de développer ma sensibilité artistique.",
  },
];
---

<BaseLayout
  title="À propos — Sanjali Frédélisy"
  description="Sanjali Frédélisy, étudiante en BTS Communication. Parcours, valeurs et passions — musique, création visuelle et projets créatifs."
>
  <section
    class="relative flex min-h-screen items-center justify-center overflow-hidden bg-gradient-to-br from-[#f0e7d7] via-[#f9e0da]/30 to-[#f0e7d7] px-6 py-32"
  >
    {/* Motif décoratif : nœuds-papillon, identique à la page d'accueil */}
    <svg
      class="pointer-events-none absolute inset-0 z-0 h-full w-full"
      aria-hidden="true"
    >
      <defs>
        <g id="about-ribbon-bow">
          <path d="M-2,-3 C-16,-15 -30,-7 -27,2 C-25,10 -12,8 -2,3 Z" />
          <path d="M-1,4 C-5,15 -10,25 -15,35 L-10,34 C-6,25 -2,15 2,5 Z" />
          <g transform="scale(-1,1)">
            <path d="M-2,-3 C-16,-15 -30,-7 -27,2 C-25,10 -12,8 -2,3 Z" />
            <path d="M-1,4 C-5,15 -10,25 -15,35 L-10,34 C-6,25 -2,15 2,5 Z" />
          </g>
          <ellipse cx="0" cy="0" rx="3.4" ry="4.4" />
        </g>
        <pattern
          id="about-bow-pattern"
          width="150"
          height="140"
          patternUnits="userSpaceOnUse"
        >
          <use
            href="#about-ribbon-bow"
            transform="translate(75,58) scale(0.8)"
            fill="none"
            stroke="#5c2c1f"
            stroke-width="1.3"
            stroke-opacity="0.09"
            stroke-linejoin="round"
            stroke-linecap="round"
          />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#about-bow-pattern)" />
    </svg>

    <div class="relative z-10 mx-auto max-w-7xl">
      <h1
        data-reveal
        class="mb-16 text-center font-serif text-5xl text-[#5c2c1f] md:text-6xl"
      >
        À propos
      </h1>

      <div data-reveal class="grid items-start gap-16 md:h-[600px] md:grid-cols-2">
        <div class="flex h-full w-full justify-center">
          <div class="relative h-[500px] w-full max-w-md md:h-full">
            <div
              class="absolute inset-0 rounded-3xl bg-gradient-to-br from-[#bd988d]/30 to-[#e3a0a3]/30 blur-2xl"
            >
            </div>
            <div
              class="relative h-full w-full overflow-hidden rounded-3xl shadow-2xl"
            >
              <Image
                src={sanjaliPhoto}
                alt="Sanjali Frédélisy"
                widths={[400, 600, 900]}
                sizes="(min-width: 768px) 50vw, 100vw"
                class="h-full w-full object-cover"
                loading="eager"
              />
            </div>
          </div>
        </div>

        <div
          id="about-scroll"
          class="custom-scrollbar relative h-full overflow-y-auto pr-4"
        >
          <div id="about-scroll-content" class="space-y-6 pb-6 text-[#5c2c1f]/90">
            <p class="text-lg leading-relaxed">
              Je m'appelle <span class="font-semibold text-[#702a0c]"
                >Sanjali Fredelisy</span
              > et j'évolue dans le domaine de la communication.
            </p>
            <p class="text-lg leading-relaxed">
              Je suis très intéressée par la création visuelle et les nouveaux
              projets. J'aime imaginer, créer et suivre des projets, ainsi que
              concevoir différents supports de communication.
            </p>
            <p class="text-lg leading-relaxed">
              Curieuse et organisée, je prends plaisir à apprendre chaque jour à
              travers mes missions, mais surtout j'ai envie de continuer à
              m'améliorer et à évoluer dans mon domaine.
            </p>
            <p class="text-lg leading-relaxed">
              Mon objectif est de développer mes compétences en communication,
              tout en réussissant à apporter une touche personnelle et créative
              à mon travail.
            </p>
            <p class="text-lg leading-relaxed">
              Dans la vie, j'ai plusieurs passions que je cultive depuis des
              années, notamment la musique, je joue du piano, ainsi que le
              sport. Mon parcours personnel et professionnel m'a appris la
              rigueur et la régularité, des valeurs que j'essaie aujourd'hui
              d'appliquer à ma formation et à mon futur métier.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-24">
        <h2
          data-reveal
          class="mb-16 text-center font-serif text-3xl text-[#5c2c1f] md:text-4xl"
        >
          Mon parcours
        </h2>

        {/* Frise horizontale — ordinateur */}
        <div data-reveal class="relative mx-auto hidden max-w-5xl md:block">
          <div
            class="absolute top-2.5 right-[10%] left-[10%] h-0.5 -translate-y-1/2 bg-gradient-to-r from-[#bd988d] via-[#702a0c] to-[#e3a0a3]"
          >
          </div>
          <ol class="grid grid-cols-5">
            {
              parcours.map((step) => (
                <li class="flex flex-col items-center px-3 text-center">
                  <span class={`relative z-10 ${dotClass(step.upcoming)}`} />
                  <p class="mt-6 font-serif text-lg leading-snug text-[#5c2c1f]">
                    {step.label}
                  </p>
                  {step.detail && (
                    <p class="mt-1.5 text-sm text-[#702a0c]/70">{step.detail}</p>
                  )}
                </li>
              ))
            }
          </ol>
        </div>

        {/* Frise verticale — mobile */}
        <ol data-reveal class="mx-auto max-w-md space-y-6 md:hidden">
          {
            parcours.map((step, index) => (
              <li class="flex gap-4">
                <div class="flex flex-col items-center">
                  <span class={dotClass(step.upcoming)} />
                  {index < parcours.length - 1 && (
                    <span class="mt-1 w-0.5 flex-1 bg-[#702a0c]/25" />
                  )}
                </div>
                <div class="pb-1">
                  <p class="font-serif text-lg leading-snug text-[#5c2c1f]">
                    {step.label}
                  </p>
                  {step.detail && (
                    <p class="mt-1 text-sm text-[#702a0c]/70">{step.detail}</p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="mt-24">
        <h2
          data-reveal
          class="mb-12 text-center font-serif text-3xl text-[#5c2c1f] md:text-4xl"
        >
          Mes qualités
        </h2>
        <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-3">
          {
            qualities.map((quality, index) => (
              <div data-reveal style={`--reveal-delay: ${index * 90}ms`}>
                <div
                  tabindex="0"
                  class="group relative flex aspect-square cursor-default items-center justify-center overflow-hidden rounded-3xl bg-gradient-to-br from-[#bd988d]/25 to-[#e3a0a3]/25 p-6 text-center shadow-lg ring-1 ring-[#5c2c1f]/10 transition-shadow duration-300 hover:shadow-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-[#702a0c]"
                >
                  <span class="px-2 font-serif text-2xl text-[#702a0c] transition-all duration-300 group-hover:-translate-y-1 group-hover:opacity-0 group-focus:-translate-y-1 group-focus:opacity-0">
                    {quality.title}
                  </span>
                  <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-[#5c2c1f] p-6 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus:opacity-100">
                    <span class="font-serif text-xl text-[#e3a0a3]">
                      {quality.title}
                    </span>
                    <p class="text-sm leading-snug text-[#f0e7d7]/90">
                      {quality.description}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mt-24">
        <h2
          data-reveal
          class="mb-12 text-center font-serif text-3xl text-[#5c2c1f] md:text-4xl"
        >
          Mes passions
        </h2>
        <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            passions.map((passion, index) => (
              <div
                data-reveal
                style={`--reveal-delay: ${index * 90}ms`}
                class="flex justify-center"
              >
                <div
                  tabindex="0"
                  class="group relative flex aspect-square w-full max-w-[15rem] cursor-default items-center justify-center overflow-hidden rounded-full bg-gradient-to-br from-[#bd988d]/25 to-[#e3a0a3]/25 p-6 text-center shadow-lg ring-1 ring-[#5c2c1f]/10 transition-shadow duration-300 hover:shadow-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-[#702a0c]"
                >
                  <span class="px-2 font-serif text-2xl text-[#702a0c] transition-all duration-300 group-hover:-translate-y-1 group-hover:opacity-0 group-focus:-translate-y-1 group-focus:opacity-0">
                    {passion.title}
                  </span>
                  <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 rounded-full bg-[#5c2c1f] p-8 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus:opacity-100">
                    <span class="font-serif text-lg text-[#e3a0a3]">
                      {passion.title}
                    </span>
                    <p class="text-xs leading-snug text-[#f0e7d7]/90">
                      {passion.description}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <script>
    import Lenis from 'lenis';

    let lenis: Lenis | null = null;
    let rafId = 0;

    function setupAboutScroll() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const wrapper = document.getElementById('about-scroll');
      const content = document.getElementById('about-scroll-content');
      if (!wrapper || !content) return;

      lenis?.destroy();
      lenis = new Lenis({
        wrapper,
        content,
        lerp: 0.1,
        smoothWheel: true,
      });

      const loop = (time: number) => {
        lenis?.raf(time);
        rafId = requestAnimationFrame(loop);
      };
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(loop);
    }

    function teardownAboutScroll() {
      lenis?.destroy();
      lenis = null;
      cancelAnimationFrame(rafId);
    }

    setupAboutScroll();
    document.addEventListener('astro:after-swap', setupAboutScroll);
    document.addEventListener('astro:before-preparation', teardownAboutScroll);
  </script>

  <script>
    function setupReveal() {
      const els = Array.from(
        document.querySelectorAll<HTMLElement>('[data-reveal]'),
      );
      if (!els.length) return;
      if (
        !('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        els.forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
      );
      els.forEach((el) => observer.observe(el));
    }

    setupReveal();
    document.addEventListener('astro:page-load', setupReveal);
  </script>

  <style is:global>
    [data-reveal] {
      opacity: 0;
      transform: translateY(28px);
      transition:
        opacity 0.7s ease-out,
        transform 0.7s ease-out;
      transition-delay: var(--reveal-delay, 0ms);
    }
    [data-reveal].is-visible {
      opacity: 1;
      transform: none;
    }
    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>
</BaseLayout>
